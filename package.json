{
  "name": "store-data-api",
  "version": "1.0.0",
  "private": true,
  "description": "Normalized app store data service: Google Play, App Store and Steam behind one versioned API.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "ingest": "bun src/cli/ingest.ts",
    "ratecheck": "bun src/cli/ratecheck.ts",
    "seed": "bun src/cli/seed.ts",
    "docker:build": "docker build -t store-data-api .",
    "compare-parsers": "bun src/cli/compare-parsers.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "drizzle-orm": "^0.44.7",
    "google-play-scraper": "^10.0.2",
    "hono": "^4.11.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "^1.3.4",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3"
  }
}
