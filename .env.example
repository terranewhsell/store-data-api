# Store Data API - environment
#
# Copy to .env and fill in. NEVER commit .env; it is in .gitignore.
# No value in this file is real. The two that must be set before the service
# will answer anything are DATABASE_URL and API_BEARER_TOKEN.

# =============================================================================
# REQUIRED
# =============================================================================

# PostgreSQL connection string.
#   Local Postgres : postgres://user:password@localhost:5432/storedata
#   Managed (Neon) : postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
#   Embedded       : pglite://./data/pgdata
#
# `pglite://` is a real Postgres compiled to WebAssembly, no server needed. Same
# engine, same schema, same SQL. It is what the test suite runs on.
#
# It is SINGLE-PROCESS. Two processes on one directory overwrite each other, so
# it suits the test suite and one-off CLI runs, not the normal loop where the API
# serves while an ingest writes. Use a server for that. A second process trying
# to open the same directory refuses to start rather than serving stale data.
#
# On a managed provider, prefer the POOLED connection string. A serverless API
# opens and closes connections constantly and will exhaust a direct connection
# limit under any real traffic.
DATABASE_URL=

# Bearer token required by every /v1 route. Generate one with:
#   openssl rand -hex 32
#
# If this is empty the service still starts, but every /v1 route answers
# 503 store_no_token_configured instead of 401. That distinction is deliberate:
# "you are not authorized" and "this service is misconfigured" are different
# problems and the caller has to be able to tell them apart.
API_BEARER_TOKEN=

# =============================================================================
# SERVER
# =============================================================================

NODE_ENV=production
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# docker-compose only: host ports to publish. Change these if something on your
# machine already listens there; the stack works the same either way.
API_PORT=3000
DB_PORT=55432

# Some hosts and reverse proxies strip the Authorization header. This is the
# fallback header name the auth middleware also accepts.
AUTH_FALLBACK_HEADER=x-authorization

# =============================================================================
# DEFAULTS AND LIMITS
# =============================================================================

# Market used when a request does not specify one.
DEFAULT_COUNTRY=us
DEFAULT_LANG=en

# Pagination. per_page is clamped to max(1, min(MAX_PER_PAGE, value)).
MAX_PER_PAGE=200
DEFAULT_PER_PAGE=50

# =============================================================================
# CACHE LIFETIMES (seconds)
# =============================================================================

# A listing that appears in some chart. Changes more, carries the traffic.
TTL_APP_POPULAR=86400
# Everything else. 7 days.
TTL_APP_LONGTAIL=604800
# Charts and rankings.
TTL_RANKING=21600
# Steam review summaries.
TTL_REVIEWS=43200
# Steam full catalogue listing.
TTL_STEAM_CATALOG=86400

# =============================================================================
# OUTBOUND PACING (milliseconds between requests, jittered inside the range)
# =============================================================================
#
# Google Play is the only source that bans by IP. Treat its values as a FLOOR,
# not a target. Measure with `bun run ratecheck --source play --n 10` before
# lowering anything.
RATE_PLAY_MIN_INTERVAL_MS=2000
RATE_PLAY_MAX_INTERVAL_MS=3000

# Apple throttles its Search API hard and signals it with 403, not 429.
# /lookup is far more permissive and takes 200 ids per call.
RATE_IOS_MIN_INTERVAL_MS=3000
RATE_IOS_MAX_INTERVAL_MS=3500

RATE_STEAM_MIN_INTERVAL_MS=1500
RATE_STEAM_MAX_INTERVAL_MS=2000

# Circuit breaker. A block, a throttle or a malformed payload opens it and the
# wait doubles each time, up to BACKOFF_MAX_MS.
BACKOFF_BASE_MS=5000
BACKOFF_MAX_MS=1800000
MAX_ATTEMPTS=5

# Applies to our own outbound calls AND to the HTTP client inside
# google-play-scraper, which otherwise waits forever.
HTTP_TIMEOUT_MS=20000

# Identify yourself. Put a real contact address here before going to production;
# it is what a store operator will use to reach you instead of just blocking you.
HTTP_USER_AGENT=store-data-api/1.0 (+contact: you@example.com)

# =============================================================================
# LIVE SEARCH FALLBACK
# =============================================================================
#
# When /v1/search finds nothing locally it may query the source directly.
# App Store and Steam only, both official public APIs. NEVER Google Play: a
# user-triggered request to Play on every search loses the IP on day one.
#
# Set to false on a deployment that cannot run the ingest worker, so the API
# stays a pure reader.
LIVE_SEARCH_ENABLED=true
# The response is never held longer than this. Whatever has not answered is
# dropped and queued for the background worker instead.
LIVE_SEARCH_TIMEOUT_MS=1500
# Per token, or per IP when there is no token. This is the only route that can
# reach outside, so it is the only one a third party could use to point this
# service at Apple or Valve.
LIVE_SEARCH_RATE_LIMIT_PER_MIN=20

# =============================================================================
# INGEST WORKER
# =============================================================================
#
# Off by default, deliberately: starting a process should never begin hitting
# the stores by surprise.
#
# Leave it FALSE on any instance that sleeps on idle (most free tiers). A worker
# suspended mid-run leaves the catalogue half written. Run `bun run seed` from a
# machine that stays awake instead, pointed at the same database.
INGEST_WORKER_ENABLED=false
INGEST_WORKER_CONCURRENCY=1
INGEST_POLL_INTERVAL_MS=1000

# =============================================================================
# GOOGLE PLAY PARSER
# =============================================================================
#
# library  google-play-scraper. The default.
# own      our own parser (src/sources/play-parser), which reads the page twice
#          (schema.org and the obfuscated payload) and reports when the two
#          disagree, so a Google format change surfaces instead of going quiet.
#
# The default moved to `own` once `bun run compare-parsers` reported 47 of 47
# fields identical on live listings. Top charts are the exception and still fall
# back to the library; see the README.
PLAY_PARSER=own

# Keep the page HTML next to the parsed result. Play previously stored only the
# PARSED object, so reprocessing could re-run our normalizer but never correct a
# parser-level mistake. Set false only if storage is tight.
PLAY_STORE_HTML=true

# Attempt our own top-chart RPC before falling back to the library. OFF: it does
# not work yet (Play loads charts through an internal RPC whose transport we have
# not matched). Leave it off unless you are working on that; the code is complete
# and tested, it just always falls back.
PLAY_OWN_CHARTS=false
